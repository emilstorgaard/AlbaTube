{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_DATABASE_CONNECTION_STRING"
  },
  "JwtSettings": {
    "Secret": "YOUR_JWT_SECRET",
    "ExpiryHours": 168 //24
  },
  "FilePaths": {
    "VideoFolder": "Media/Videos",
    "ImageFolder": "Media/Images"
  },
  "FileTypes": {
    "VideoExtensions": [
      ".mp4",
      ".mov",
      ".avi",
      ".wmv",
      ".flv",
      ".mkv",
      ".webm",
      ".mpeg",
      ".mpg",
      ".3gp"
    ],
    "ImageExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".bmp",
      ".tiff",
      ".webp",
      ".svg"
    ]
  },
  "TimeZone": {
    "Default": "Central European Standard Time"
  }
}